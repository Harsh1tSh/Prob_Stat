import numpy as np

image = np.array([
    [180, 210, 240, 210, 180],
    [210, 240, 255, 240, 210],
    [240, 255, 255, 255, 240],
    [210, 240, 255, 240, 210],
    [180, 210, 240, 210, 180]
])

p = 0.8
mask = np.random.binomial(1, p, size=image.shape)

masked_image = image * mask

print("Original image:\n", image)
print("Bernoulli mask:\n", mask)
print("Masked image:\n", masked_image)
